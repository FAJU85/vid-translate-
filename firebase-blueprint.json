{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing identity and role data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "description": "User email address" },
        "displayName": { "type": "string", "description": "Display name" },
        "photoURL": { "type": "string", "description": "Avatar photo URL" },
        "role": { "type": "string", "enum": ["admin", "user"], "description": "Access role" },
        "createdAt": { "type": "string", "description": "Creation timestamp ISO" },
        "lastLoginAt": { "type": "string", "description": "Last sign in timestamp ISO" }
      },
      "required": ["uid", "email", "role"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Audit event log generated by admin and system activities",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Log entry unique ID" },
        "adminEmail": { "type": "string", "description": "Email of admin who initiated action" },
        "action": { "type": "string", "description": "Admin action performed" },
        "target": { "type": "string", "description": "Target entity or configuration" },
        "timestamp": { "type": "string", "description": "Action timestamp" },
        "status": { "type": "string", "enum": ["success", "failed"], "description": "Result status" },
        "details": { "type": "string", "description": "Additional event context" }
      },
      "required": ["id", "adminEmail", "action", "timestamp", "status"]
    },
    "UserTranslation": {
      "title": "UserTranslation",
      "description": "User translated video record with subtitle cues and sharing settings",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique translation job ID" },
        "userId": { "type": "string", "description": "Owner Firebase UID" },
        "userEmail": { "type": "string", "description": "Owner email address" },
        "videoUrl": { "type": "string", "description": "Original video URL or upload source" },
        "videoTitle": { "type": "string", "description": "Video title" },
        "videoDuration": { "type": "number", "description": "Duration in seconds" },
        "youtubeId": { "type": "string", "description": "YouTube video ID if applicable" },
        "thumbnailUrl": { "type": "string", "description": "Video thumbnail preview" },
        "srcLang": { "type": "string", "description": "Source audio language" },
        "tgtLang": { "type": "string", "description": "Target language" },
        "tgtDialect": { "type": "string", "description": "Target Arabic dialect" },
        "subtitleMode": { "type": "string", "enum": ["soft", "hard"], "description": "Subtitle mode" },
        "status": { "type": "string", "enum": ["queued", "running", "done", "failed"], "description": "Job status" },
        "isShared": { "type": "boolean", "description": "Whether public sharing link is enabled" },
        "createdAt": { "type": "string", "description": "Creation timestamp ISO" },
        "updatedAt": { "type": "string", "description": "Last update timestamp ISO" }
      },
      "required": ["id", "userId", "videoTitle", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User documents storing profile and authorization metadata"
    },
    "/audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Administrative audit entries record"
    },
    "/user_translations/{translationId}": {
      "schema": "UserTranslation",
      "description": "User translated video records with subtitle cues"
    }
  }
}
